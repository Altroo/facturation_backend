[
  {
    "type": "function",
    "function": {
      "name": "search_records",
      "description": "Search projects/tasks or permitted chat messages; all filters combine with AND.",
      "parameters": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "enum": [
              "project",
              "task",
              "message"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 120
          },
          "project_name": {
            "type": "string",
            "maxLength": 120
          },
          "assignee_name": {
            "type": "string",
            "maxLength": 120
          },
          "mine": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "maxLength": 120
          },
          "overdue": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "resource"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
