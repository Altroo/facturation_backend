  {
    "type": "function",
    "function": {
      "name": "time_report",
      "description": "Manager-only native recorded and live person-time. Includes every collaborator; one workday = 480 minutes.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string",
            "maxLength": 120
          },
          "date_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "prepare_change",
      "description": "PROPOSE a known project/task edit or archive; requires separate human confirmation. Never deletes.",
      "parameters": {
        "type": "object",
        "properties": {
          "resource": {
            "enum": [
              "project",
              "task"
            ]
          },
          "identifier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "operation": {
            "enum": [
              "update",
              "archive"
            ]
          },
          "changes": {
            "type": "object",
            "maxProperties": 5,
            "propertyNames": {
              "enum": [
                "blocked_reason",
                "description",
                "due_date",
                "name",
                "priority",
                "start_date",
                "target_end_date",
                "title"
              ]
            },
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        },
        "required": [
          "resource",
          "identifier",
          "operation"
        ],
        "additionalProperties": false
      }
    }
  }
