[
  {
    "type": "function",
    "function": {
      "name": "search_invoices",
      "description": "Search invoices by exact number, client name, date interval or unpaid balance. Dates ISO. No guessed year.",
      "parameters": {
        "type": "object",
        "properties": {
          "invoice_number": {
            "type": "string",
            "maxLength": 120
          },
          "client_name": {
            "type": "string",
            "maxLength": 120
          },
          "date_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "unpaid": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
