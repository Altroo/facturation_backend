# Runtime uploads are mounted by Compose, never baked into an image.
media/
staticfiles/
.git/
.venv*/
venv/
__pycache__/
*.pyc
.pytest_cache/
htmlcov/
coverage.xml
.coverage*
.DS_Store
tmp/

# Runtime configuration is injected by Compose, never copied into image layers.
.env*
*.env
*.key
*.pem
*.p12
*.pfx
*.dump
*.sql.gz
.auth/
playwright/.auth/
**/training/evaluations/
